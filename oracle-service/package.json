{
  "name": "@iln/oracle-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Off-chain payer verification oracle for Invoice Liquidity Network",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^15.0.1",
    "express": "^4.21.2",
    "prom-client": "^15.1.3",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/supertest": "^6.0.2",
    "@types/node": "^24.7.2",
    "supertest": "^7.0.0",
    "tsx": "^4.15.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
