{
  "name": "@iln/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Invoice Liquidity Network Soroban contract.",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/react-native/index.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "react-native": {
    ".": "./dist/react-native/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": ">=0.72"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup",
    "prepare": "husky install || true",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:integration": "vitest run src/integration.test.ts",
    "test:integration:testnet": "vitest run src/integration/testnet.test.ts",
    "test:e2e-local": "vitest run src/e2e/*.test.ts",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "docs:generate": "typedoc --out ../docs/sdk-api src/index.ts"
  },
  "dependencies": {
    "@iln/shared": "workspace:*",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^15.0.1",
    "axios": "^1.16.0"
  },
  "devDependencies": {
    "@iln/eslint-config": "workspace:*",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "@commitlint/cli": "^17.6.0",
    "@commitlint/config-conventional": "^17.6.0",
    "husky": "^8.0.0",
    "tsup": "^8.5.0",
    "typedoc": "^0.27.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
