# Notification service configuration
NOTIFICATIONS_DB_PATH=notifications.sqlite
NOTIFICATIONS_RPC_URL=http://localhost:8000
NOTIFICATIONS_CONTRACT_ID=G...CONTRACTID
NOTIFICATIONS_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=no-reply@invoice-liquidity.network
NOTIFICATIONS_POLL_INTERVAL_MS=30000
NOTIFICATIONS_START_LEDGER=0
DUE_WARNING_HOURS=48
PORT=4001
RATE_LIMIT_PER_USER=60
RATE_LIMIT_PER_RECIPIENT=200
RATE_LIMIT_WINDOW_MS=60000
# Issue #1277: provider attempts per journal row before it is dead-lettered
NOTIFICATIONS_MAX_DISPATCH_ATTEMPTS=8
# Issue #1280: 32-byte key (openssl rand -hex 32) protecting recipient data at
# rest. Required when NODE_ENV=production.
NOTIFICATIONS_RECIPIENT_KEY=
# NOTIFICATIONS_RECIPIENT_KEY_PREVIOUS=
