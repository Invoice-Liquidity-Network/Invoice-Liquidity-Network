{
  "name": "@iln/shared",
  "version": "0.1.0",
  "description": "Shared ILN domain types for the SDK, frontend, and related packages.",
  "license": "MIT",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && tsd"
  },
  "tsd": {
    "directory": "test-d",
    "compilerOptions": {
      "target": "ES2020",
      "module": "ESNext",
      "moduleResolution": "bundler",
      "strict": true,
      "baseUrl": ".",
      "paths": {
        "@iln/shared": [
          "./dist/index.d.ts"
        ]
      }
    }
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "tsd": "^0.31.2",
    "typescript": "^5.9.3"
  }
}
