{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "./dist",
    "baseUrl": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "paths": {
      "@iln/shared": ["../shared/src/index.ts"],
      "@iln/shared/*": ["../shared/src/*"],
      "@iln/sdk": ["../../sdk/src/compatibility.ts"],
      "@iln/sdk/*": ["../../sdk/src/*"]
    }
  },
  "include": ["src/**/*"]
}
