{
  "name": "@iln/cli",
  "version": "0.1.0",
  "description": "[Experimental, not yet documented] Command-line interface for the Invoice Liquidity Network. See cli/ (@invoice-liquidity/cli) for the canonical, documented CLI.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "iln": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm --dts --clean",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@iln/sdk": "^0.1.0",
    "@stellar/stellar-sdk": "^15.0.1",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "picocolors": "^1.1.1",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
