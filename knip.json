{
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts"
      ],
      "project": [
        "scripts/**/*.ts"
      ],
      "ignoreDependencies": [
        "husky"
      ]
    },
    "packages/sdk": {
      "entry": [
        "index.ts",
        "__tests__/**/*.test.ts",
        "src/index.browser.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts"
      ],
      "ignoreDependencies": [
        "@commitlint/cli",
        "@commitlint/config-conventional",
        "@playwright/test",
        "jest",
        "ts-jest",
        "tsup",
        "tsx",
        "vite",
        "vite-plugin-wasm"
      ],
      "ignoreExports": [
        "src/crypto-browser.ts",
        "src/index.browser.ts"
      ]
    },
    "cli": {
      "entry": [
        "src/bin.ts",
        "src/cli.ts"
      ],
      "project": [
        "src/**/*.ts"
      ],
      "ignoreDependencies": [
        "@commitlint/cli",
        "@commitlint/config-conventional"
      ]
    },
    "indexer": {
      "project": [
        "src/**/*.ts"
      ],
      "ignoreDependencies": [
        "@commitlint/cli",
        "@commitlint/config-conventional"
      ]
    },
    "notifications": {
      "entry": [
        "src/index.ts",
        "src/service.ts"
      ],
      "project": [
        "src/**/*.ts"
      ],
      "ignoreDependencies": [
        "@commitlint/cli",
        "@commitlint/config-conventional"
      ]
    },
    "docs": {
      "entry": [
        "pages/**/*.{ts,tsx,mdx}",
        "theme.config.jsx",
        "next.config.{js,mjs}"
      ],
      "project": [
        "**/*.{ts,tsx,jsx}"
      ]
    },
    "packages/indexer": {
      "project": [
        "src/**/*.ts"
      ],
      "ignoreDependencies": [
        "@commitlint/cli",
        "@commitlint/config-conventional"
      ]
    },
    "packages/opentelemetry": {
      "entry": [
        "tests/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/scripts": {
      "entry": [
        "**/*.{ts,js}"
      ],
      "project": [
        "**/*.{ts,js}"
      ]
    }
  },
  "ignoreExportsUsedInFile": true
}
